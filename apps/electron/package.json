{
  "name": "@codex-router/electron",
  "version": "0.4.0-beta.4",
  "private": true,
  "description": "Electron desktop companion for Codex Model Router",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check ../../src/desktop-commands.mjs",
    "test:e2e": "node --test e2e.test.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "io.github.codex-router.electron",
    "productName": "Codex Model Router",
    "directories": {
      "output": "release",
      "buildResources": "../desktop/src-tauri/icons"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../desktop/ui",
        "to": "app/apps/desktop/ui"
      },
      {
        "from": "../desktop/src-tauri/icons",
        "to": "app/apps/desktop/src-tauri/icons"
      },
      {
        "from": "../../config",
        "to": "app/config"
      },
      {
        "from": "../../src",
        "to": "app/src"
      },
      {
        "from": "../../package.json",
        "to": "app/package.json"
      },
      {
        "from": "../../node_modules",
        "to": "app/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../desktop/src-tauri/icons/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "../desktop/src-tauri/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Codex Model Router"
    },
    "executableName": "codex-router-electron"
  },
  "author": "Codex Router contributors",
  "repository": "https://github.com/duolahypercho/codex-router"
}
